{{define "content"}}
<h1>Edit user</h1>
<form class="form-grid" method="post" action="/users/{{.User.ID}}/update">
	{{csrfField .CSRFToken}}
	<label>Name <input name="name" type="text" value="{{.User.Name}}" required></label>
	<label>Phone number <input name="phone" type="tel" value="{{.User.Phone}}" required></label>
	<button type="submit">Update user</button>
</form>
<p><a href="/users">Cancel</a></p>
{{end}}
