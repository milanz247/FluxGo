{{define "content"}}
<h1>Users</h1>

<form class="form-grid" method="post" action="/users"
	hx-post="/users" hx-target="#users-body" hx-swap="beforeend">
	{{csrfField .CSRFToken}}
	<label>Name <input name="name" type="text" required></label>
	<label>Phone number <input name="phone" type="tel" required></label>
	<button type="submit">Add user</button>
</form>

<table>
	<thead>
		<tr><th>ID</th><th>Name</th><th>Phone number</th><th>Actions</th></tr>
	</thead>
	<tbody id="users-body">
		{{range .Users}}
		<tr id="user-{{.ID}}">
			<td>{{.ID}}</td>
			<td>{{.Name}}</td>
			<td>{{.Phone}}</td>
			<td>
				<div class="actions">
					<a href="/users/{{.ID}}">View</a>
					<a href="/users/{{.ID}}/edit">Edit</a>
					<form class="inline" method="post" action="/users/{{.ID}}/delete"
						hx-post="/users/{{.ID}}/delete" hx-target="closest tr" hx-swap="outerHTML">
						{{csrfField $.CSRFToken}}
						<button type="submit">Delete</button>
					</form>
				</div>
			</td>
		</tr>
		{{else}}
		<tr id="empty-users"><td colspan="4">No users have been added.</td></tr>
		{{end}}
	</tbody>
</table>
{{end}}
