{{define "content"}}
<h1>User details</h1>
<table>
	<tbody>
		<tr><th>ID</th><td>{{.User.ID}}</td></tr>
		<tr><th>Name</th><td>{{.User.Name}}</td></tr>
		<tr><th>Phone number</th><td>{{.User.Phone}}</td></tr>
	</tbody>
</table>
<p>
	<a href="/users/{{.User.ID}}/edit">Edit</a>
	<a href="/users">Back to users</a>
</p>
{{end}}
