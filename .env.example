APP_NAME=FluxGo
APP_ENV=local
SERVER_ADDR=:8080
VIEWS_ROOT=views
SESSION_COOKIE=flux_session
SESSION_LIFETIME_MINUTES=120
SESSION_SECURE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fluxgo
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME_MINUTES=60
DB_AUTO_MIGRATE=true
